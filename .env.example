# Postgres connection string
DATABASE_URL=postgres://mukalim:mukalim@localhost:5432/mukalim

# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated list of allowed origins (the frontend's URLs)
CORS_ORIGINS=http://localhost:3000,https://mukalim-v2.vercel.app

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Uploads — stored in Supabase Storage (bucket "media", see
# drizzle/0003_create_media_storage_bucket.sql and src/utils/storage.ts),
# not local disk. SUPABASE_URL is the same project as DATABASE_URL, in
# https://<project-ref>.supabase.co form. SUPABASE_SERVICE_ROLE_KEY is the
# secret service_role key from Supabase Dashboard → Project Settings → API
# — bypasses RLS entirely, treat it like DATABASE_URL/JWT secrets, never
# expose it to a client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me-service-role-key
MAX_UPLOAD_SIZE_MB=10

# Seed
SEED_DEMO_PASSWORD=Password123!
